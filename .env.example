# App
NEXT_PUBLIC_APP_NAME=Central de Comunicação Interna
APP_DB_SCHEMA=comunicacao

# Auth.js / Entra ID — valores reais só em .env.local (não versionar)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Impersonação de papéis SEM senha. true só em development + localhost. Proibido em produção.
# AUTH_DEV_BYPASS=true
# AUTH_ALLOW_DEV_LOGIN=true

# Grupos Entra (object IDs). AUTH_ADMIN_GROUP_IDS continua aceito como alias de comunicador.
AUTH_COMMUNICATOR_GROUP_IDS=
AUTH_COLLABORATOR_GROUP_IDS=
AUTH_ADMIN_GROUP_IDS=
AUTH_USER_GROUP_IDS=

# SQL Server local (docker compose). Nunca apontar desenvolvimento para Azure de produção.
DATABASE_URL="sqlserver://localhost:1433;database=comunicacao-interna_dev;user=sa;password=LocalDev_Password1;encrypt=true;trustServerCertificate=true"

# Web Push (VAPID). A chave privada nunca vai para o cliente.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:comunicacao-interna@localhost
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Cron de publicação agendada
CRON_SECRET=

# Storage local de capas (fora do Git)
FILE_STORAGE_DIR=uploads
