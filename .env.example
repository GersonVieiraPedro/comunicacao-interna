# App
NEXT_PUBLIC_APP_NAME=Central de Comunicação Interna
APP_DB_SCHEMA=comunicacao

# Auth.js — sessão JWT. Valores reais só em .env.local / Vercel.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Login interno (padrão). Contas via seed — sem auto-cadastro.
# SEED_DEFAULT_PASSWORD=ChangeMe_Comunicacao1
# SEED_ADMIN_EMAIL=admin@empresa.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Administrador

# Entra ID (opcional). Se vazio, só e-mail/senha.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Impersonação SEM senha. true só em development + localhost. Proibido em produção.
# AUTH_DEV_BYPASS=true
# AUTH_ALLOW_DEV_LOGIN=true

# Grupos Entra (só se Entra ativo)
AUTH_COMMUNICATOR_GROUP_IDS=
AUTH_COLLABORATOR_GROUP_IDS=
AUTH_ADMIN_GROUP_IDS=
AUTH_USER_GROUP_IDS=

# SQL Server
DATABASE_URL="sqlserver://localhost:1433;database=comunicacao-interna_dev;user=sa;password=LocalDev_Password1;encrypt=true;trustServerCertificate=true"

# Web Push (VAPID)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:comunicacao-interna@localhost
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Cron
CRON_SECRET=

# Storage local de capas
FILE_STORAGE_DIR=uploads
# Azure Blob (recomendado em produção). URL do container + SAS:
# AZURE_BLOB_TOKEN=https://ACCOUNT.blob.core.windows.net/CONTAINER?sv=...&sig=...
# Opcional Vercel Blob (alternativa):
# BLOB_READ_WRITE_TOKEN=
