generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["comunicacao"]
}

/// Usuário da app. Login interno (e-mail/senha) ou Entra opcional.
/// entraObjectId = subject estável (OID Entra, ou "cred:<email>", ou local-dev-*).
model User {
  id            String   @id @default(uuid())
  entraObjectId String   @unique
  email         String   @unique
  displayName   String
  /// bcrypt hash; null = só SSO / bypass local sem senha
  passwordHash  String?
  /// false = sem acesso (login bloqueado)
  active        Boolean  @default(true)
  /// ACTIVE | INACTIVE | NONE — sem ACTIVE → perfil efetivo CANDIDATE (exceto METARH/CLIENT)
  contractStatus        String?  @db.NVarChar(32)
  /// TEMPORARY | THIRD_PARTY
  contractType          String?  @db.NVarChar(32)
  economicGroup         String?  @db.NVarChar(120)
  cnpj                  String?  @db.NVarChar(18)
  healthPlan            String?  @db.NVarChar(120)
  reimbursementCard     String?  @db.NVarChar(120)
  /// Vínculo cliente ↔ alocados (mesmo id lógico / CNPJ raiz)
  clientOrgId           String?  @db.NVarChar(64)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roles                 UserRole[]
  authored              Communication[]       @relation("CommunicationAuthor")
  published             Communication[]       @relation("CommunicationPublisher")
  reads                 CommunicationRead[]
  pushSubscriptions     PushSubscription[]
  notifications         Notification[]
  auditEvents           AuditEvent[]
  notificationDeliveries NotificationDelivery[]

  @@index([contractStatus])
  @@index([cnpj])
  @@index([economicGroup])
  @@index([clientOrgId])
  @@map("users")
  @@schema("comunicacao")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  /// METARH | CLIENT | COLLABORATOR | CANDIDATE (legado: COMMUNICATOR → METARH)
  role   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
  @@schema("comunicacao")
}

model CommunicationCategory {
  id             String          @id @default(uuid())
  slug           String
  name           String
  sortOrder      Int             @default(0)
  communications Communication[]

  @@unique([slug])
  @@map("communication_categories")
  @@schema("comunicacao")
}

model Communication {
  id                  String    @id @default(uuid())
  title               String    @db.NVarChar(200)
  subtitle            String?   @db.NVarChar(300)
  summary             String    @db.NVarChar(500)
  bodyHtml            String    @db.NVarChar(Max)
  coverPath           String?   @db.NVarChar(Max)
  categoryId          String
  authorUserId        String
  publishedByUserId   String?
  /// DRAFT | SCHEDULED | PUBLISHED | EXPIRED | CANCELLED
  status              String
  /// NORMAL | IMPORTANT | URGENT
  priority            String
  /// ALL | FILTERED
  audienceType        String    @default("ALL")
  scheduledPublishAt  DateTime?
  publishedAt         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  category     CommunicationCategory @relation(fields: [categoryId], references: [id])
  author       User                  @relation("CommunicationAuthor", fields: [authorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publishedBy  User?                 @relation("CommunicationPublisher", fields: [publishedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targets      CommunicationTarget[]
  reads        CommunicationRead[]
  notifications Notification[]
  deliveries   NotificationDelivery[]
  auditEvents  AuditEvent[]
  deliveryJobs DeliveryJob[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorUserId])
  @@index([priority, publishedAt])
  @@map("communications")
  @@schema("comunicacao")
}

/// Critérios de audiência FILTERED (AND entre linhas da mesma communication).
model CommunicationTarget {
  id              String        @id @default(uuid())
  communicationId String
  /// CONTRACT_STATUS | CONTRACT_TYPE | ECONOMIC_GROUP | CNPJ | HEALTH_PLAN | REIMBURSEMENT_CARD | USER_ID | ROLE
  targetType      String        @db.NVarChar(40)
  targetValue     String        @db.NVarChar(200)
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
  @@index([targetType, targetValue])
  @@map("communication_targets")
  @@schema("comunicacao")
}

model CommunicationRead {
  id              String        @id @default(uuid())
  userId          String
  communicationId String
  /// Abriu o comunicado (automático)
  firstViewedAt   DateTime      @default(now())
  lastViewedAt    DateTime      @default(now())
  viewCount       Int           @default(1)
  /// Confirmação explícita de ciência ("marcar como lido" / Entendi)
  acknowledgedAt  DateTime?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@unique([userId, communicationId])
  @@index([communicationId])
  @@index([communicationId, acknowledgedAt])
  @@map("communication_reads")
  @@schema("comunicacao")
}

model PushSubscription {
  id           String    @id @default(uuid())
  userId       String
  endpoint     String    @db.NVarChar(Max)
  endpointHash String
  p256dh       String
  auth         String
  userAgent    String?   @db.NVarChar(500)
  active       Boolean   @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([endpointHash])
  @@index([userId, active])
  @@map("push_subscriptions")
  @@schema("comunicacao")
}

model Notification {
  id              String        @id @default(uuid())
  userId          String
  communicationId String
  title           String        @db.NVarChar(200)
  body            String        @db.NVarChar(500)
  /// Clique/abertura da notificação (push ou lista)
  openedAt        DateTime?
  /// Marcada como tratada na lista (pode diferir do acknowledge do comunicado)
  readAt          DateTime?
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@unique([userId, communicationId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([communicationId, openedAt])
  @@map("notifications")
  @@schema("comunicacao")
}

/// Fila de fan-out (in-app + push). Publicação enfileira; worker processa em lotes.
model DeliveryJob {
  id              String        @id @default(uuid())
  /// FANOUT_PUBLICATION
  type            String
  communicationId String
  /// PENDING | PROCESSING | COMPLETED | FAILED
  status          String
  /// JSON: { phase: "in_app"|"push", offset: number }
  cursor          String?       @db.NVarChar(Max)
  attempts        Int           @default(0)
  lastError       String?       @db.NVarChar(500)
  availableAt     DateTime      @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([communicationId, type])
  @@map("delivery_jobs")
  @@schema("comunicacao")
}

model NotificationDelivery {
  id              String         @id @default(uuid())
  communicationId String
  userId          String?
  /// IN_APP | WEB_PUSH
  channel         String
  /// PENDING | SENT | FAILED | SKIPPED
  status          String
  errorCode       String?
  createdAt       DateTime       @default(now())
  communication   Communication  @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([communicationId, channel])
  @@index([status, createdAt])
  @@map("notification_deliveries")
  @@schema("comunicacao")
}

model AuditEvent {
  id              String         @id @default(uuid())
  /// COMMUNICATION_CREATED | COMMUNICATION_EDITED | COMMUNICATION_PUBLISHED | SCHEDULE_CANCELLED | COMMUNICATION_CANCELLED | COMMUNICATION_VIEWED
  action          String
  actorUserId     String?
  communicationId String?
  metadata        String?        @db.NVarChar(1000)
  createdAt       DateTime       @default(now())
  actor           User?          @relation(fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  communication   Communication? @relation(fields: [communicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([communicationId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
  @@schema("comunicacao")
}

/// FAQ editável por METARH (base única).
model FaqEntry {
  id        String   @id @default(uuid())
  question  String   @db.NVarChar(300)
  answer    String   @db.NVarChar(Max)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("faq_entries")
  @@schema("comunicacao")
}

/// Links úteis editáveis por METARH (exibidos na página FAQ).
model UsefulLinkEntry {
  id          String   @id @default(uuid())
  label       String   @db.NVarChar(160)
  href        String   @db.NVarChar(500)
  description String?  @db.NVarChar(300)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("useful_link_entries")
  @@schema("comunicacao")
}
