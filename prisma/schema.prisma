generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["comunicacao"]
}

/// Projeção local do usuário Entra ID. Sem senha.
model User {
  id            String   @id @default(uuid())
  entraObjectId String   @unique
  email         String
  displayName   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roles                 UserRole[]
  authored              Communication[]       @relation("CommunicationAuthor")
  published             Communication[]       @relation("CommunicationPublisher")
  reads                 CommunicationRead[]
  pushSubscriptions     PushSubscription[]
  notifications         Notification[]
  auditEvents           AuditEvent[]
  notificationDeliveries NotificationDelivery[]

  @@index([email])
  @@map("users")
  @@schema("comunicacao")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  /// COLLABORATOR | COMMUNICATOR
  role   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
  @@schema("comunicacao")
}

model CommunicationCategory {
  id             String          @id @default(uuid())
  slug           String
  name           String
  sortOrder      Int             @default(0)
  communications Communication[]

  @@unique([slug])
  @@map("communication_categories")
  @@schema("comunicacao")
}

model Communication {
  id                  String    @id @default(uuid())
  title               String    @db.NVarChar(200)
  subtitle            String?   @db.NVarChar(300)
  summary             String    @db.NVarChar(500)
  bodyHtml            String    @db.NVarChar(Max)
  coverPath           String?   @db.NVarChar(500)
  categoryId          String
  authorUserId        String
  publishedByUserId   String?
  /// DRAFT | SCHEDULED | PUBLISHED | EXPIRED | CANCELLED
  status              String
  /// NORMAL | IMPORTANT | URGENT
  priority            String
  /// ALL (MVP). Segmentação futura não usa outro valor ainda.
  audienceType        String    @default("ALL")
  scheduledPublishAt  DateTime?
  publishedAt         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  category     CommunicationCategory @relation(fields: [categoryId], references: [id])
  author       User                  @relation("CommunicationAuthor", fields: [authorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publishedBy  User?                 @relation("CommunicationPublisher", fields: [publishedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targets      CommunicationTarget[]
  reads        CommunicationRead[]
  notifications Notification[]
  deliveries   NotificationDelivery[]
  auditEvents  AuditEvent[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorUserId])
  @@index([priority, publishedAt])
  @@map("communications")
  @@schema("comunicacao")
}

/// Reserva para segmentação futura (departamento, unidade, grupo). MVP não popula.
model CommunicationTarget {
  id              String        @id @default(uuid())
  communicationId String
  /// DEPARTMENT | UNIT | ROLE | GROUP | LOCATION
  targetType      String
  targetValue     String
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
  @@map("communication_targets")
  @@schema("comunicacao")
}

model CommunicationRead {
  id              String        @id @default(uuid())
  userId          String
  communicationId String
  firstViewedAt   DateTime      @default(now())
  lastViewedAt    DateTime      @default(now())
  viewCount       Int           @default(1)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@unique([userId, communicationId])
  @@index([communicationId])
  @@map("communication_reads")
  @@schema("comunicacao")
}

model PushSubscription {
  id           String    @id @default(uuid())
  userId       String
  endpoint     String    @db.NVarChar(Max)
  endpointHash String
  p256dh       String
  auth         String
  userAgent    String?   @db.NVarChar(500)
  active       Boolean   @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([endpointHash])
  @@index([userId, active])
  @@map("push_subscriptions")
  @@schema("comunicacao")
}

model Notification {
  id              String        @id @default(uuid())
  userId          String
  communicationId String
  title           String        @db.NVarChar(200)
  body            String        @db.NVarChar(500)
  readAt          DateTime?
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
  @@schema("comunicacao")
}

model NotificationDelivery {
  id              String         @id @default(uuid())
  communicationId String
  userId          String?
  /// IN_APP | WEB_PUSH
  channel         String
  /// PENDING | SENT | FAILED | SKIPPED
  status          String
  errorCode       String?
  createdAt       DateTime       @default(now())
  communication   Communication  @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([communicationId, channel])
  @@index([status, createdAt])
  @@map("notification_deliveries")
  @@schema("comunicacao")
}

model AuditEvent {
  id              String         @id @default(uuid())
  /// COMMUNICATION_CREATED | COMMUNICATION_EDITED | COMMUNICATION_PUBLISHED | SCHEDULE_CANCELLED | COMMUNICATION_CANCELLED | COMMUNICATION_VIEWED
  action          String
  actorUserId     String?
  communicationId String?
  metadata        String?        @db.NVarChar(1000)
  createdAt       DateTime       @default(now())
  actor           User?          @relation(fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  communication   Communication? @relation(fields: [communicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([communicationId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
  @@schema("comunicacao")
}
